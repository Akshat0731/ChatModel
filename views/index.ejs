<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini WhatsApp</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h3>All Chats</h3>
    <form action="/chats/new" method="GET">
        <button>New Chat!</button>
        <br>
    </form>
    <%for(let chat of chats){%>
        <div class="chat">
            <p>From: <i><%=chat.from%></i></p>
            <div class="msg">
                <p>Message: <%=chat.msg%></p>
                    <form action="/chats/<%=chat._id%>/edit" method="GET">
                        <button>Edit Chat</button>
                    </form>
                    <br>
                    <form action="/chats/<%=chat._id%>?_method=DELETE" method="POST">
                        <button class="delete">Delete Chat</button>
                    </form>
                    <br>
                    <form action="/chats/<%=chats._id%>" method="GET">
                        <button class="show">Show Chat</button>
                    </form>
            </div>
            <p>Received By: <i><%=chat.to%></i></p>
            <hr>
            <p>Time:<%=chat.created_at.toString().split(" ")[4]%></p>
            <p>Date:<%=chat.created_at.toString().split(" ").slice(0,4).join("-")%></p>
        </div>
        <br><br>
    <%}%>
    <script src="app.js"></script>
</body>
</html>